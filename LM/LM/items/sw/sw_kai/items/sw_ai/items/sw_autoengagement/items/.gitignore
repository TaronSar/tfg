# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
/experiments/

.github/

# --- ML project specific (datasets live on the NAS; data/ holds small derived
#     artifacts that are DVC pipeline outputs, never committed as raw files) ---
/data/**
# re-include directories so the .gitkeep negation below can apply
!/data/**/
!/data/**/.gitignore
!/data/**/*.dvc
!/data/**/.gitkeep

# Trained weights, galleries and exported models
/models/**
!/models/.gitkeep
*.pth
*.ckpt
*.onnx
*.npy

# Training/eval outputs
/logs/
/graphs/
/csvs/
/galleries/
*.log

# Notebook checkpoints
.ipynb_checkpoints/
