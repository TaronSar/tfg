# Data directories
# LOCAL_NAS_PATH: NAS mount path (same on all Vision servers; Linux mount)
LOCAL_NAS_PATH=/mnt/Pool_IA/IA_Dataset

# FiftyOne configuration
FIFTYONE_DATABASE_URI=mongodb://192.168.2.1:27017/fiftyone
FIFTYONE_LANCEDB_URI=/mnt/Pool_IA/IA_Dataset/lancedb

# CVAT configuration
CVAT_HOST=192.168.2.1
CVAT_EXTERNAL_PORT=8080
TRAEFIK_DASHBOARD_EXTERNAL_PORT=8090
CVAT_URL=http://192.168.2.1:8080
FIFTYONE_CVAT_USERNAME=root
FIFTYONE_CVAT_PASSWORD=root

# MLflow configuration
MLFLOW_TRACKING_URI=http://192.168.2.1:5000
MLFLOW_EXPERIMENT_NAME=uav_few_shot_identification
