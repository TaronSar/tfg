# Veronte Kai — Identidad de placa para flasheo
# Usado por scripts/lib/stage4_flash_wrapper.sh para generar flash_veronte_kai.sh

BOARDID=3767
BOARDSKU=0003
FAB=000
BOARDREV=A.0

# Archivo .conf dentro de Linux_for_Tegra/ (creado por el parche 0002)
BOARD_CONF=veronte_kai

# Target de flash: internal = QSPI NOR (bootloader) + SD card (rootfs vía extlinux)
FLASH_TARGET=internal
